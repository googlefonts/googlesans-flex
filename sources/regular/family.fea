feature tnum {
    sub @FIGURES by @FIGURES_TAB;
    sub @SYMBOLS by @SYMBOLS_TAB;
} tnum;


feature liga {
    sub f f b by f_f_b;
    sub f f h by f_f_h;
    sub f f i by f_f_i;
    sub f f j by f_f_j;
    sub f f k by f_f_k;
    sub f f l by f_f_l;
    sub f f t by f_f_t;
    sub f b by f_b;
    sub f i by f_i;
    sub f f by f_f;
    sub f h by f_h;
    sub f j by f_j;
    sub f k by f_k;
    sub f l by f_l;
    sub f t by f_t;
    sub t f by t_f;
    sub t t by t_t;
#     sub [G g] o o g l e underscore l o g o by Google.logo;
#     sub [G g] o o g l e l o g o l i g a t u r e by Google.logo;
#     sub G l o g o l i g a t u r e by G.logo;
#     sub o l o g o l i g a t u r e by o.logo;
#     sub g l o g o l i g a t u r e by g.logo;
#     sub l l o g o l i g a t u r e by l.logo;
#     sub e l o g o l i g a t u r e by e.logo;
} liga;



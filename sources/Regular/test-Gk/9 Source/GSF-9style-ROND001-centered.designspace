<?xml version='1.0' encoding='UTF-8'?>
<designspace format="5.0">
  <axes>
<!-- new funky wght axis, only k stem is varying -->
    <axis tag="wght" name="Weight" minimum="1" maximum="1000" default="400"/>
<!-- same as before -->
    <axis tag="GRAD" name="Grade" minimum="0" maximum="50" default="0"/>
    <axis tag="ROND" name="Round" minimum="0" maximum="100" default="0.1"/>
  </axes>
  <sources>
<!-- new funky wght axis, only k stem is varying -->
    <source filename="GoogleSansFlex-opsz18-wdth100-wght1-ROND000.ufo" familyname="Google Sans Flex" stylename="opsz18-wdth100-wght1-ROND000">
      <location>
        <dimension name="wght" xvalue="1"/>
        <dimension name="Grade" xvalue="0"/>
        <dimension name="Round" xvalue="0"/>
      </location>
    </source>
    <source filename="GoogleSansFlex-opsz18-wdth100-wght1000-ROND000.ufo" familyname="Google Sans Flex" stylename="opsz18-wdth100-wght1000-ROND000">
      <location>
        <dimension name="wght" xvalue="1000"/>
        <dimension name="Grade" xvalue="0"/>
        <dimension name="Round" xvalue="0"/>
      </location>
    </source>
    <source filename="GoogleSansFlex-opsz18-wdth100-wght1-ROND001.ufo" familyname="Google Sans Flex" stylename="opsz18-wdth100-wght1-ROND001">
      <location>
        <dimension name="wght" xvalue="1"/>
        <dimension name="Grade" xvalue="0"/>
        <dimension name="Round" xvalue="0.1"/>
      </location>
    </source>
    <source filename="GoogleSansFlex-opsz18-wdth100-wght1000-ROND001.ufo" familyname="Google Sans Flex" stylename="opsz18-wdth100-wght1000-ROND001">
      <location>
        <dimension name="wght" xvalue="1000"/>
        <dimension name="Grade" xvalue="0"/>
        <dimension name="Round" xvalue="0.1"/>
      </location>
    </source>
<!-- same as before -->
    <source filename="GoogleSansFlex-opsz18-wdth100-wght400-ROND001-GRAD50.ufo" familyname="Google Sans Flex" stylename="opsz18-wdth100-wght400-ROND001-GRAD50">
      <location>
        <dimension name="wght" xvalue="400"/>
        <dimension name="Grade" xvalue="50"/>
        <dimension name="Round" xvalue="0.1"/>
      </location>
    </source>
    <source filename="GoogleSansFlex-opsz18-wdth100-wght400-ROND100.ufo" familyname="Google Sans Flex" stylename="opsz18-wdth100-wght400-ROND100">
      <location>
        <dimension name="wght" xvalue="400"/>
        <dimension name="Grade" xvalue="0"/>
        <dimension name="Round" xvalue="100"/>
      </location>
    </source>
    <source filename="GoogleSansFlex-opsz18-wdth100-wght400-ROND001.ufo" familyname="Google Sans Flex" stylename="opsz18-wdth100-wght400-ROND001">
      <location>
        <dimension name="wght" xvalue="400"/>
        <dimension name="Grade" xvalue="0"/>
        <dimension name="Round" xvalue="0.1"/>
      </location>
    </source>
    <source filename="GoogleSansFlex-opsz18-wdth100-wght400-ROND000.ufo" familyname="Google Sans Flex" stylename="opsz18-wdth100-wght400-ROND000">
      <location>
        <dimension name="wght" xvalue="400"/>
        <dimension name="Grade" xvalue="0"/>
        <dimension name="Round" xvalue="0"/>
      </location>
    </source>
    <source filename="GoogleSansFlex-opsz18-wdth100-wght400-ROND000-GRAD50.ufo" familyname="Google Sans Flex" stylename="opsz18-wdth100-wght400-ROND000-GRAD50">
      <location>
        <dimension name="wght" xvalue="400"/>

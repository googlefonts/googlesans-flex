    #sub f f k by f_f_k;
    #sub f f l by f_f_l;
    #sub f f t by f_f_t;
    #sub f b by f_b;
    sub f i by f_i;
    #sub f f by f_f;
    #sub f h by f_h;
    #sub f j by f_j;
    #sub f k by f_k;
    sub f l by f_l;
    #sub f t by f_t;
    #sub t f by t_f;
    #sub t t by t_t;
    
} liga;
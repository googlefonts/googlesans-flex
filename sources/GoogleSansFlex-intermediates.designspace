<?xml version='1.0' encoding='UTF-8'?>
<designspace format="4.1">
	<axes>
		<axis tag="wght" name="wght" minimum="1" maximum="1000" default="400">
			<labelname xml:lang="en">weight</labelname>
		</axis>
		<axis tag="wdth" name="wdth" minimum="25" maximum="151" default="100">
			<labelname xml:lang="en">width</labelname>
<!--
			<map input="25" output="-1"/>
			<map input="100" output="0.058823529411764705"/>
			<map input="151" output="1"/>
-->
		</axis>
		<axis tag="opsz" name="opsz" minimum="6" maximum="144" default="18">
			<labelname xml:lang="en">optical size</labelname>
		</axis>
		<axis tag="ROND" name="ROND" minimum="0" maximum="100" default="0">
			<labelname xml:lang="en">ROUNDED</labelname>
		</axis>
	</axes>
	<sources>
		
		
